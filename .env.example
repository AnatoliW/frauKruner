APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Vertrauenswuerdige Proxys, kommagetrennt, oder `*` fuer alle.
# Nur setzen, wenn die Anwendung ausschliesslich hinter einem Proxy erreichbar
# ist – etwa lokal hinter einem Tunnel (./tunnel.sh). Wer als Proxy gilt, darf
# Host, Schema und Absender-IP der Anfrage bestimmen; leer heisst: keinem
# vertrauen. Ohne diesen Eintrag erzeugt die Anwendung hinter einem
# HTTPS-Tunnel `http://`-Adressen und die signierten Zahlungslinks schlagen fehl.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fraukruner
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Lokal: Mailpit (SMTP 1025, Web-UI http://127.0.0.1:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@fraukruner.de"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Micropayment – Online-Überweisung (Open Banking via Tink)
# Zugangsdaten stehen im Control-Center: controlcenter.micropayment.de
# Solange MICROPAYMENT_ACCESS_KEY leer ist, zeigt der Shop statt der Weiterleitung
# eine Vorschau der erzeugten Zahlungsfenster-URL.
MICROPAYMENT_ENABLED=true
MICROPAYMENT_ACCESS_KEY=
# Die technische Projekt-Kennung, nicht der Anzeigename des Projekts.
# Sie steht in der Bezahlfenster-URL im Control-Center hinter "?project=".
MICROPAYMENT_PROJECT=
MICROPAYMENT_ACCOUNT=
# Testmodus: solange true, fließt kein Geld. Vor dem Livegang auf false stellen.
MICROPAYMENT_TESTMODE=true
# Aufbau: https://<paymentdomain>.micropayment.de/<payment>/<service>/
# Die technischen Bezeichner heißen weiterhin "sofort", obwohl hinter der Zahlart
# inzwischen Tink steht. Dass Domain und Pfad auseinanderlaufen, ist so vorgesehen –
# der Wert stammt aus dem Control-Center (Hilfe -> Integration Web -> URL).
MICROPAYMENT_ONLINE_TRANSFER_URL=https://directbanking.micropayment.de/sofort/event/
MICROPAYMENT_LANGUAGE=de

# Darstellung des Bezahlfensters. Diese Werte liefert das Control-Center
# zusammen mit der Bezahlfenster-URL mit. Was leer bleibt, wird nicht gesendet.
MICROPAYMENT_THEME=
MICROPAYMENT_GFX=
MICROPAYMENT_BGCOLOR=
MICROPAYMENT_PRODUCTTYPE=

# Absicherung der Benachrichtigung. Das Geheimfeld im Control-Center bei der
# Zahlart als zusätzlichen Parameter hinterlegen und hier denselben Wert setzen.
# Pflicht: Solange der Wert leer ist, könnte jeder, der eine Bestellnummer und
# den Betrag kennt, die Bestellung als bezahlt melden. Die Anwendung lehnt ohne
# Geheimfeld deshalb jede Benachrichtigung ab.
MICROPAYMENT_SECRET_FIELD_NAME=secretfield
MICROPAYMENT_SECRET_FIELD_VALUE=
# Nur für die Einrichtung, solange im Control-Center noch kein Geheimfeld
# hinterlegt ist: nimmt Benachrichtigungen ungeprüft an. Damit steht der Endpunkt
# offen — nicht auf einem erreichbaren Server setzen und vor dem Livegang wieder
# entfernen. Mit APP_ENV=production wirkt die Freischaltung nicht.
MICROPAYMENT_ALLOW_UNAUTHENTICATED_NOTIFICATION=false
# Nach dem Livegang auf false setzen, sonst gilt eine Testbuchung als Zahlung.
MICROPAYMENT_ALLOW_TESTMODE_NOTIFICATION=false
# Nur vorübergehend einschalten, um das Testwerkzeug im Control-Center zu nutzen.
MICROPAYMENT_ALLOW_APICHECK=false
MICROPAYMENT_CHECK_AMOUNT=true
# Nach der Verarbeitung zur Ergebnisseite weiterleiten. Ohne Weiterleitung bleibt
# die Kundin auf der Seite von Micropayment stehen.
MICROPAYMENT_NOTIFICATION_FORWARD=true
MICROPAYMENT_NOTIFICATION_TARGET=_self

VITE_APP_NAME="${APP_NAME}"
